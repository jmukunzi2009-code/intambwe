# INTAMBWE - Environment Configuration Example
# Copy this file to .env.local and configure your environment variables.

# Neon PostgreSQL connection string from your Neon project dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Application URL
APP_URL=http://localhost:3000
NODE_ENV=development

# Session signing secret (use a unique random value; never commit the real value).
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Initial Super Administrator Setup (set locally; never commit real credentials).
SUPER_ADMIN_NAME=Your Name
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password

# Email Delivery (Resend or equivalent, optional for local dev)
EMAIL_FROM=notifications@intambwe.org
EMAIL_API_KEY=
